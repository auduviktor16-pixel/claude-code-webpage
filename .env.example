# Email (Resend) — required for the contact form to actually send mail.
# Get a key at https://resend.com. Without it, the form still validates
# client-side but submissions fail gracefully with a clear error message.
RESEND_API_KEY=

# Recipient address for contact form submissions, also shown publicly in
# the footer/contact section (not a secret, hence NEXT_PUBLIC_).
NEXT_PUBLIC_CONTACT_EMAIL=auduviktor16@gmail.com

# Production URL — used for canonical links, Open Graph tags, and the
# sitemap. CHANGE THIS before launching to a real domain.
NEXT_PUBLIC_SITE_URL=https://auduvictor.com

# Optional social links. Leave blank to omit that link entirely — no
# placeholder or dead links are ever rendered.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional live BetapayAI URL. Leave blank to hide the "Explore BetapayAI"
# CTA rather than link to a placeholder.
NEXT_PUBLIC_BETAPAY_URL=

# Optional video. Set this AND drop the matching file into `public/video/`
# to enable the video section. Leave blank to keep it hidden.
NEXT_PUBLIC_VIDEO_SRC=
